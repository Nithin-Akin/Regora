NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=repograph-local
NEO4J_URI=bolt://neo4j:7687
REDIS_URL=redis://redis:6379/0
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:1.7b
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
GITHUB_TOKEN=
# Keep local for a single-user install. Use github for authenticated workspaces.
AUTH_MODE=local
# Generate both with: openssl rand -base64 32
AUTH_SECRET=
AUTH_SHARED_SECRET=
# Create a GitHub OAuth App and use http://localhost:3000/api/auth/callback/github locally.
AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
DATA_DIR=/data
DEMO_DIR=/demo/shop
MAX_ARCHIVE_MB=50
MAX_EXTRACTED_MB=250
MAX_FILES=10000
MAX_FILE_BYTES=1000000
JOB_TIMEOUT=1800
CONTEXT_CHARS=6000
